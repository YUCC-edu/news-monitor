{
  "name": "news-monitor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter @news/web dev",
    "dev:worker": "pnpm --filter @news/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "queue:inspect": "tsx --env-file=.env scripts/inspect-queue-failures.ts",
    "queue:retry-fetch": "tsx --env-file=.env scripts/retry-fetch-failed.ts",
    "queue:retry-enrich": "tsx --env-file=.env scripts/retry-enrich-failed.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
