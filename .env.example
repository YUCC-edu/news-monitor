# --- Auth ---
AUTH_SECRET=replace-me-with-random-32-chars
AUTH_USER=admin
# 用 `pnpm --filter @news/web exec node scripts/hash-password.mjs <yourPassword>` 生成
AUTH_PASS_HASH=

# --- Database ---
DATABASE_URL=postgres://news:news@localhost:5432/news

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RSSHub ---
RSSHUB_BASE=http://localhost:1200

# --- LLM (OpenAI 兼容) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
