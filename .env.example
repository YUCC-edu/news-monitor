# --- Database ---
DATABASE_URL=postgres://news:news@127.0.0.1:55432/news

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- RSSHub ---
RSSHUB_BASE=http://localhost:1200

# --- WeWe-RSS（公众号订阅网关）---
# 运行 `docker compose up -d wewe-rss` 后，打开 http://127.0.0.1:4000 扫码绑定微信
WEWE_RSS_BASE=http://127.0.0.1:4000
WEWE_RSS_AUTH_CODE=change-me

# --- Fetcher ---
# 当信源的「首次回溯天数」为空时，用此值（天）限制首抓条目，避免历史全量倒灌；默认 1 ≈ 24 小时
FIRST_FETCH_MAX_AGE_DAYS=1

# --- LLM (OpenAI 兼容) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=deepseek-embedding

# --- 聚类 / 多源事件（可选调参）---
# 成员向量近邻检索：只看最近 N 小时内 enrich 过的条目（默认 72）
# CLUSTER_EMBEDDING_NEIGHBOR_HOURS=168
# 每个候选来源：最多返回 K 个簇（按簇内最佳相似度排序，默认 8）
# CLUSTER_EMBEDDING_MEMBER_TOP_K=8
# 与簇质心向量比对的 Top-K（默认 5；需库里有 centroid_embedding）
# CLUSTER_CENTROID_TOP_K=5
# 并入已有簇的最低余弦相似度（0–1，默认 0.86）
# CLUSTER_SIM_THRESHOLD=0.86
