# news-monitor environment template
#
# First startup copies this file to .env.
# Keep real secrets in .env only. Never commit .env, .env.local, or .env.backup.*.

# ---------------------------------------------------------------------------
# Required local services
# ---------------------------------------------------------------------------

# Postgres is started by docker/compose.yaml on localhost:55432.
DATABASE_URL=postgres://news:news@127.0.0.1:55432/news

# Redis is started by docker/compose.yaml on localhost:6379.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Local access and admin guard
# ---------------------------------------------------------------------------

# 0 = only trust localhost access. 1 = allow LAN Host access.
ALLOW_LAN=0

# 1 = protect admin-like API routes when accessed outside localhost.
APP_ENFORCE_AUTH=1

# Optional admin token for protected API routes.
# Leave empty for local-only development.
APP_ADMIN_TOKEN=

# Optional assistant/action token. Not required for normal Web usage.
ASSISTANT_ENFORCE_AUTH=0
ASSISTANT_API_KEY=

# ---------------------------------------------------------------------------
# Fetch dependencies
# ---------------------------------------------------------------------------

# RSSHub is started by docker/compose.yaml.
RSSHUB_BASE=http://localhost:1200

# WeWe-RSS is started by docker/compose.yaml.
# Open http://127.0.0.1:4000 after startup if you need to bind a WeChat account.
WEWE_RSS_BASE=http://127.0.0.1:4000
WEWE_RSS_AUTH_CODE=change-me

# Limit the first backfill when a source has no explicit first-fetch limit.
# 1 means roughly the last 24 hours.
FIRST_FETCH_MAX_AGE_DAYS=1

# ---------------------------------------------------------------------------
# AI runtime
# ---------------------------------------------------------------------------

# core  = default. No LLM key required.
# llm   = use your OpenAI-compatible LLM configuration below.
# agent = reserved for external Agent workflows; not the default user path.
AI_MODE=core

# OpenAI-compatible LLM settings.
# Required only when AI_MODE=llm.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_CONCURRENCY=2
LLM_DAILY_REQUEST_BUDGET=500

# ---------------------------------------------------------------------------
# Optional local debugging
# ---------------------------------------------------------------------------

# LOG_LEVEL=info
# LOG_MODULES=worker:index,worker:fetch-source,worker:enrich-item

# Set to 1 to print timeline item forwarding traces in server logs.
# NM_LOG_TIMELINE=1
# NEXT_PUBLIC_NM_LOG_TIMELINE=1

# ---------------------------------------------------------------------------
# Optional clustering tuning
# ---------------------------------------------------------------------------

# How far back to search enriched items when looking for cluster neighbors.
# CLUSTER_EMBEDDING_NEIGHBOR_HOURS=168

# Max candidate clusters returned by member similarity.
# CLUSTER_EMBEDDING_MEMBER_TOP_K=8

# Top-K centroid candidates when centroid embeddings exist.
# CLUSTER_CENTROID_TOP_K=5

# Minimum cosine similarity for embedding-based cluster merge.
# CLUSTER_SIM_THRESHOLD=0.86
